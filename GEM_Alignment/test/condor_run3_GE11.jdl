universe              = vanilla
executable            = condor_run3_GE11.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = condor_run3_GE11.py, file_names.list
output                = out/$(ClusterId).$(ProcId).out
error                 = err/$(ClusterId).$(ProcId).err
log                   = log/$(ClusterId).log
request_cpus          = 2
request_memory        = 4000M
+JobFlavour           = "workday"
arguments             = $(ProcId)
queue 995